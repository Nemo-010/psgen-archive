From 3c4eb103f360d03d3839e02376d356aebe4a92a7 Mon Sep 17 00:00:00 2001
From: Nemo <328747105+Nemo-010@users.noreply.github.com>
Date: Mon, 9 Nov 2026 03:20:07 +0000
Subject: [PATCH 09/10] tests: skip what the host cannot do instead of aborting
 the suite

tests/smoke.sh aborted on three host properties that are normal in a container,
none of them psgen's fault, and each abort killed the whole suite so no later
check ran at all:

* a finite hard RLIMIT_FSIZE: limited() asked for a 1 GiB soft limit while the
  hard limit was 953 MiB, and setrlimit refuses to raise soft above hard, so
  preexec_fn raised SubprocessError. Clamp to the hard limit; 2048 MiB still
  exceeds any limit the test can install.
* no /dev/ptmx: the pty assertion failed even though `psgen doctor` correctly
  reports pty DENY and inject reports the degradation. Skip it when doctor says
  the host has no pty.
* a PID 1 that does not reap: the --duration and --busy liveness checks used
  os.kill(pid, 0), which succeeds for a zombie, so they could never pass. Use a
  helper that treats a zombie as gone.

Before: the suite stopped at the first of the three. After: it runs to
completion and prints "invariants: ok / smoke: ok" on this host.
---
 tests/invariants.py | 39 +++++++++++++++++++++++++--------------
 1 file changed, 25 insertions(+), 14 deletions(-)

diff --git a/tests/invariants.py b/tests/invariants.py
index d2ce893..6c8cdb3 100644
--- a/tests/invariants.py
+++ b/tests/invariants.py
@@ -410,7 +410,8 @@ def check_injection():
              "--no-mem"], tmp, 30)
         time.sleep(0.4)
         rows = ps_rows()
-        if not any(rows.get(p) and rows[p]["tty"].startswith("pts/") for p in pids):
+        if can_pty() and not any(rows.get(p) and rows[p]["tty"].startswith("pts/")
+                                 for p in pids):
             fail("no injected process acquired a pty")
         if not any(rows.get(p) and "l" in rows[p]["stat"] for p in pids):
             fail("no injected process showed the threaded stat flag")
@@ -555,21 +556,15 @@ def check_injection():
              "--no-threads", "--duration", "1"], tmp, 2)
         time.sleep(2.2)
         for pid in pids:
-            try:
-                os.kill(pid, 0)
+            if alive(pid):
                 fail(f"pid {pid} survived --duration 1")
-            except ProcessLookupError:
-                pass
         stop_pidfile(pidfile)
         pidfile, pids, _ = inject_and_check(
             ["inject", "-n", "2", "--no-user", "--no-mem", "--no-tty",
              "--no-threads", "--wait", "--duration", "1"], tmp, 2)
         for pid in pids:
-            try:
-                os.kill(pid, 0)
+            if alive(pid):
                 fail(f"pid {pid} survived --wait --duration 1")
-            except ProcessLookupError:
-                pass
         stop_pidfile(pidfile)
 
         pidfile, pids, _ = inject_and_check(
@@ -587,11 +582,8 @@ def check_injection():
             fail("--busy produced no CPU time")
         time.sleep(2.2)
         for p in pids:
-            try:
-                os.kill(p, 0)
+            if alive(p):
                 fail(f"--busy --duration 2 pid {p} survived")
-            except ProcessLookupError:
-                pass
         stop_pidfile(pidfile)
 
 
@@ -950,7 +942,10 @@ def check_load():
     def limited(args, fsize):
         def preexec():
             soft, hard = resource.getrlimit(resource.RLIMIT_FSIZE)
-            lim = hard if fsize is None else fsize
+            # a soft limit can never exceed the hard limit: clamping keeps the
+            # guard test runnable on a host whose hard RLIMIT_FSIZE is finite
+            lim = hard if fsize is None else (
+                fsize if hard == resource.RLIM_INFINITY else min(fsize, hard))
             resource.setrlimit(resource.RLIMIT_FSIZE, (lim, hard))
         cmd = [str(BIN)] + [str(a) for a in args]
         return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
@@ -972,6 +967,22 @@ def check_load():
         fail("load --disk-util ignored the RLIMIT_FSIZE guard")
 
 
+def can_pty() -> bool:
+    """True when this host lets a process acquire a pty (doctor says so)."""
+    p = run(["doctor", "--json"])
+    return '"pty":{"ok":true' in p.stdout.replace(" ", "")
+
+
+def alive(pid: int) -> bool:
+    """False when the PID is gone, or when it is a zombie left by a parent
